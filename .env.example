# Copy to .env in the repository root. setup.sh and setup.bat do this when
# .env is missing. The API loads this file on startup and does not override
# variables that are already set in the environment.
#
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Working files for an export. Leave unset to use backend/data/jobs.
# A relative path is resolved from the process working directory.
# JOBS_DIR=./data/jobs

# Netscape cookies.txt. Do not commit the cookie file.
# YTDLP_COOKIES_FILE=

# Cookie file contents, or the same contents encoded as base64.
# Prefer YTDLP_COOKIES_FILE on a local machine.
# YTDLP_COOKIES=

# Browser to read cookies from: chrome, brave, edge, firefox, or safari.
# Use none to skip browser cookies. The desktop app sets this itself.
# YTDLP_COOKIES_BROWSER=

# Full path to Deno 2.3 or newer when cookies are used and deno is not on PATH.
# YTDLP_DENO=

# Shared password for the API. Required on a hosted server, which will not start
# without it or with one shorter than 12 characters. Leave unset for local use
# and the desktop app.
# COMPCREATOR_PASSWORD=

# Proxies in front of a hosted server that each append to X-Forwarded-For.
# The failed-password throttle uses the entry this many places from the right.
# 1 fits Cloud Run's own URL; add one per load balancer or CDN in front of it.
# COMPCREATOR_TRUSTED_PROXY_HOPS=1
