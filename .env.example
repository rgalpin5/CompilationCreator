# Backend (backend/app/config.py)
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Where job working files and finished mp4s are written. Defaults to backend/data/jobs.
JOBS_DIR=./data/jobs

# Frontend (put in frontend/.env.local)
# Leave unset on the Vercel project. The browser calls `/api` on the same
# domain, and Vercel routes that prefix to the backend service.
# Set this only for split local dev (Next on :3000, uvicorn on :8000).
NEXT_PUBLIC_API_URL=http://localhost:8000
