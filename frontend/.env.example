# Copy to frontend/.env.local. setup.sh and setup.bat do this when the file
# is missing. Next.js inlines this value when the dev server starts.
#
# On Vercel, set it in the project settings to the Cloud Run API URL.
# Set it for local development, where the UI is on port 3000 and the API is on port 8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
